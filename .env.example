# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (Used ONLY in server-side administrative tasks and NEVER exposed to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id

# Site URL for SEO and Metadata Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
